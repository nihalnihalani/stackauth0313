# =============================================================================
# HiveMind - Environment Variables
# =============================================================================

# --- AI Provider API Keys ---

# Google Gemini (Default provider - required for out-of-the-box experience)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI (Optional - configure in Settings modal)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Optional - configure in Settings modal)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Ollama (Optional - no key needed, runs locally)
# Default base URL: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# --- Stack Auth (Future Integration) ---

# Stack Auth Project ID
NEXT_PUBLIC_STACK_PROJECT_ID=
# Stack Auth Publishable Client Key
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
# Stack Auth Secret Server Key (never expose in client code)
STACK_SECRET_SERVER_KEY=
